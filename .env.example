# Optional environment overrides. Prefer config.toml for non-secret local settings.
# Optional portable data root. npm installations set this automatically to a
# per-user application folder; GitHub clones default to the repository folder.
# JOB_ASSISTANT_HOME=C:\path\to\private\job-assistant-data
# A separate local Chrome profile, used only by this assistant. Do not commit .env.
JOB_ASSISTANT_USER_DATA_DIR=data/browser-profile
# Use Google Chrome when installed. Set to chromium to use Playwright Chromium instead.
JOB_ASSISTANT_BROWSER=chrome
# Optional: folder containing PDF/DOCX resumes. The newest file is used automatically.
JOB_ASSISTANT_RESUME_DIR=resumes
